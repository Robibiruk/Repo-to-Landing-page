# GitHub personal access token (public_repo scope). Required for higher rate limits + private repos.
GITHUB_TOKEN=

# OpenRouter API key. Required unless LLM_PROVIDER=mock.
OPENROUTER_API_KEY=sk_*****

# Model used for generation. Defaults to a free open-source model (Nemotron 3 120B).
# For higher quality copy, set anthropic/claude-sonnet-5 (paid, per-token — a few cents per page).
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Comma-separated free-model fallbacks used when the primary is rate-limited (429).
# Free tiers share upstream pools, so this makes generation resilient.
# A/B'd: nemotron (primary) passes the critic; poolside is reliable but weak; gemma 429s often.
OPENROUTER_FALLBACK_MODELS=poolside/laguna-s-2.1:free,google/gemma-4-31b-it:free

# Quality gate: after generation, a critic scores the copy and drives a targeted rewrite.
QUALITY_GATE=true
# Max targeted refine rounds after a failed critique (bounds latency/cost on the free tier).
MAX_REFINE_ROUNDS=1

# Share-loop badge target: where "Built with RepoPages" links on generated pages.
# Empty = badge is not a link. Point at the product/gallery once live.
REPOPAGES_URL=

# CORS: comma-separated origins (localhost + deployed frontend URL).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Which LLM backend to use: openrouter | mock
LLM_PROVIDER=openrouter